[Unit]
Description=MOSA private stats session authentication
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
ExecStart=__MOSA_NODE_BIN__ __MOSA_SITE_ROOT__/scripts/admin-auth.mjs
Environment=MOSA_AUTH_PASSWORD_FILE=__MOSA_AUTH_PASSWORD_FILE__
Environment=MOSA_AUTH_STATE_FILE=__MOSA_AUTH_STATE_FILE__
Environment=MOSA_AUTH_PORT=__MOSA_AUTH_PORT__
Restart=on-failure
RestartSec=2s
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectControlGroups=true
PrivateDevices=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
ReadWritePaths=__MOSA_AUTH_STATE_DIR__

[Install]
WantedBy=multi-user.target
