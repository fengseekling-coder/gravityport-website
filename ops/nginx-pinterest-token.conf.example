# Pinterest token relay endpoint
# 服务器上是 /etc/nginx/snippets/gravityport-pinterest-token.conf，由官网 HTTPS server 块 include
# （mosa.azhuilab.com 和 gravityport.azhuilab.com 共用这个 server 块；App 调的是 gravityport 域名）。
# scripts/install-pinterest-token.sh 会把 __PINTEREST_TOKEN_PORT__ 换成真实端口（默认 39128）并装好。

# limit_req_zone 要放在 http {} 块里（服务器上是 /etc/nginx/conf.d/gravityport-pinterest-token-zone.conf）：
# limit_req_zone $binary_remote_addr zone=pinterest_token:1m rate=10r/m;

location = /api/pinterest/token {
    limit_req zone=pinterest_token burst=2 nodelay;
    limit_req_status 429;

    if ($request_method != POST) {
        return 405;
    }

    client_max_body_size 8k;
    # 请求体里有授权码和刷新令牌；访问日志关掉，错误日志也不写（限流拦截时会记访客 IP）。
    access_log off;
    error_log /dev/null crit;

    proxy_pass http://127.0.0.1:__PINTEREST_TOKEN_PORT__/token;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_read_timeout 20s;
    proxy_connect_timeout 5s;
}
