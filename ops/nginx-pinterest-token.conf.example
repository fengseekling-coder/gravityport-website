# Pinterest token relay endpoint
# 放在 mosa.azhuilab.com 的 HTTPS server 块里

# limit_req_zone 要放在 http {} 块里（不在 server 块里）：
# limit_req_zone $binary_remote_addr zone=pinterest_token:1m rate=10r/m;

location = /api/pinterest/token {
    limit_req zone=pinterest_token burst=2 nodelay;
    limit_req_status 429;

    if ($request_method != POST) {
        return 405;
    }

    client_max_body_size 8k;
    access_log off;

    proxy_pass http://127.0.0.1:39128/token;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_read_timeout 20s;
    proxy_connect_timeout 5s;
}
