# 挡住随仓库一起同步到网站根目录、但不该给外网看的文件
# 放在 mosa.azhuilab.com 的 HTTPS server 块里（服务器上是 /etc/nginx/snippets/mosa-website-private-paths.conf）
#
# 为什么不在部署时直接排除：systemd 服务和统计 cron 都从 /var/www/mosa-website/scripts/ 启动，
# 排除后服务器上的脚本就不会再更新。所以文件照传，只在 Nginx 这一层返回 404。
# 用 ^~ 前缀匹配，让这里优先于 `location ~* \.(?:css|js)$` 等正则规则。

location ^~ /scripts/ {
    return 404;
}

location ^~ /ops/ {
    return 404;
}

location = /DEPLOYMENT.md {
    return 404;
}
