# Add these locations inside the existing HTTPS `server { ... }` block for
# gravityport.azhuilab.com. The auth service listens on loopback only; it validates
# the existing /etc/nginx/.htpasswd-mosa-stats file and stores only hashed,
# 30-day session tokens outside /var/www.

location = /admin/login.html {
    try_files $uri =404;
    add_header Cache-Control "no-store, private" always;
    add_header X-Robots-Tag "noindex, nofollow, noarchive" always;
}

location = /admin/login {
    proxy_pass http://127.0.0.1:39127/login;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_connect_timeout 5s;
    proxy_read_timeout 10s;
}

location = /admin/logout {
    proxy_pass http://127.0.0.1:39127/logout;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_connect_timeout 5s;
    proxy_read_timeout 10s;
}

location = /_mosa_admin_auth {
    internal;
    proxy_pass http://127.0.0.1:39127/auth;
    proxy_pass_request_body off;
    proxy_set_header Content-Length "";
    proxy_set_header X-MOSA-Session $cookie_mosa_admin_session;
    proxy_set_header X-Real-IP $remote_addr;
}

location = /admin/ {
    auth_request /_mosa_admin_auth;
    error_page 401 =302 https://gravityport.azhuilab.com/admin/login.html;
    try_files /admin/index.html =404;
    add_header Cache-Control "no-store, private" always;
    add_header X-Robots-Tag "noindex, nofollow, noarchive" always;
}

location = /admin/stats.json {
    auth_request /_mosa_admin_auth;
    try_files $uri =404;
    add_header Cache-Control "no-store, private" always;
    add_header X-Robots-Tag "noindex, nofollow, noarchive" always;
}

location ^~ /admin/ {
    auth_request /_mosa_admin_auth;
    try_files $uri $uri/ /admin/index.html;
    add_header Cache-Control "no-store, private" always;
    add_header X-Robots-Tag "noindex, nofollow, noarchive" always;
}
