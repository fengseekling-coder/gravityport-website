.preview.log
# Local screenshots and audit captures (never part of the site).
/.*.png
.DS_Store
.env
.env.*
!.env.example

# Desktop ZIPs are larger than GitHub's single-file limit and are published
# directly from mosa/out/make/zip by the local release monitor.
downloads/MOSA-darwin-arm64-*.zip
downloads/MOSA-win32-x64-*.zip

# Generated on the production server from Nginx access logs. Never commit
# private usage aggregates into the website repository.
admin/stats.json

# Desktop update manifests live only on the server; scripts/publish-desktop-release.sh
# writes them there. A committed copy goes stale and is never deployed.
/releases/

# Impeccable working files: review captures and spent decision sketches stay local.
/.impeccable/review/
/.impeccable/mocks/
/.impeccable/questions/
/.impeccable/critique/
